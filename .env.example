APP_NAME=CalaiaPH
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000/
VITE_API_URL=https://calaia.ph

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=calaiaph
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_IDLE_TIMEOUT_MINUTES=30

# Exact production hosts, comma-separated. Do not use wildcard entries.
TRUSTED_HOSTS=calaia.ph,www.calaia.ph

# API Rate Limiting
API_RATE_LIMIT=60
API_RATE_LIMIT_DECAY=60

API_STRICT_RATE_LIMIT=10
API_STRICT_RATE_LIMIT_DECAY=30

UPLOAD_RATE_LIMIT=5
UPLOAD_RATE_LIMIT_DECAY=60

BOOKING_RATE_LIMIT=30
BOOKING_RATE_LIMIT_DECAY=60

# CORS Configuration
FRONTEND_URL=http://localhost:3000

# API Security Configuration
BLOCK_SUSPICIOUS_USER_AGENTS=true
SQL_INJECTION_PROTECTION=true
REQUIRE_JSON_CONTENT_TYPE=true
LOG_RATE_LIMITS=true
LOG_SECURITY_EVENTS=true

SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
WEATHER_CITY="Purok 3, Brgy. Bisaya, Calaca"
WEATHER_COUNTRY=PH
WEATHER_LATITUDE=13.9298
WEATHER_LONGITUDE=120.8133
WEATHER_CACHE_MINUTES=30
WEATHER_STALE_MINUTES=120
WEATHER_CONNECT_TIMEOUT_SECONDS=2
WEATHER_TIMEOUT_SECONDS=4

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="CalaiaPH"
BOOKING_ADMIN_EMAIL=calaia.ph@gmail.com
BOOKING_CHECKIN_REMINDER_ENABLED=true
BOOKING_CHECKIN_REMINDER_DAYS_BEFORE=1
BOOKING_CHECKIN_REMINDER_TIME=09:00

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=swiper_images  # optional
CLOUDINARY_URL=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# PayMongo Configuration
PAYMONGO_PUBLIC_KEY=
PAYMONGO_SECRET_KEY=

# PayMongo Webhook Secret
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_WEBHOOK_RETENTION_DAYS=180
PAYMONGO_INVALID_WEBHOOK_RETENTION_DAYS=30

# Public social login OAuth credentials.
# Use HTTPS redirect URIs outside local development.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
